-- 5.1
select l.city from departments d , locations l where d.manager_id = 108 and d.location_id = l.location_id 
select l.city from departments d inner join locations l on d.location_id = l.location_id where d.manager_id = 108
select l.city from departments d join locations l using(location_id) where d.manager_id = 108

-- 5.2
select l.city , l.postal_code , d.department_name from locations l join departments d using(location_id) where l.postal_code in('00989', '3095', 'M5V', '2L7', '98199')

-- 5.3 Названия отделов, товаров, отделов и сотрудников
select o.order_id , p.product_name , e.last_name , d.department_name , o.order_date 
from order_items oi 
join products p using(product_id)
join orders o using(order_id)
join employees e on o.salesman_id = e.employee_id 
join departments d using(department_id)
where to_char(o.order_date , 'YYYY') in ('2020')

-- 5.4
select o.order_date , sum(oi.quantity * oi.unit_price ) as amount, sum(oi.quantity ) as items_cnt
from orders o 
join order_items oi using(order_id)
group by o.order_date 

-- 5.5 Кол-во сотрудников и суммарную ЗП для каждого города
select l.location_id , l.city , count(*), sum(e.salary)
from locations l 
join departments d using(location_id)
join employees e using(department_id)
group by l.location_id 

-- 5.6 Вывести менеджеров 80го отдела и суммарную зарплату его сотрудников
select e.manager_id , count(*), sum(e.salary) from employees e where e.department_id = 80 group by e.manager_id 

-- 5.7 Сотрудники с продажами более 50ти раз больше зарплаты
select o.salesman_id  , sum(oi.quantity * oi.unit_price ) as sales, (select e.salary from employees e where e.employee_id = o.salesman_id ) as salary
from orders o 
join order_items oi using(order_id)
group by o.salesman_id having sum(oi.quantity * oi.unit_price ) > (select e.salary from employees e where e.employee_id = o.salesman_id ) * 50

-- 5.8 Отношение суммы всех продаж к ЗП для каждого отдела
select e.department_id  , round((sum(oi.quantity * oi.unit_price ) / sum(e.salary)),2) as relation
from orders o 
join order_items oi using(order_id)
join employees e on o.salesman_id = e.employee_id  
group by e.department_id 

